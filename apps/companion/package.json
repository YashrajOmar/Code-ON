{
  "name": "@codeon/companion",
  "version": "0.1.0",
  "description": "CodeOn Companion",
  "main": "electron/main.js",
  "author": "CodeOn",
  "private": true,
  "scripts": {
    "start": "npx electron electron/main.js",
    "dev": "npx electron electron/main.js --dev",
    "build": "npx electron-builder --win",
    "cli": "node src/index.js"
  },
  "build": {
    "appId": "com.codeon.companion",
    "productName": "CodeOn Companion",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "electron/icon.png" },
    "mac": { "target": "dmg", "icon": "electron/icon.png" },
    "linux": { "target": "AppImage", "icon": "electron/icon.png" }
  },
  "dependencies": {
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}