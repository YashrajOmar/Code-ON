{
  "name": "@codeon/companion",
  "version": "0.1.0",
  "description": "CodeOn Companion — auto-syncs your CF/LC submissions to train your AI mentor",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "dev": "electron electron/main.js --dev",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "cli": "node src/index.js"
  },
  "build": {
    "appId": "com.codeon.companion",
    "productName": "CodeOn Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    }
  },
  "dependencies": {
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  }
}
